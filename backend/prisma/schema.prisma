generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id        Int       @id @default(autoincrement())
  name      String
  company   String?   // empresa donde estará el alumno
  startDate DateTime? // fecha de inicio del periodo
  endDate   DateTime? // fecha de fin del periodo
  documents Document[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Document {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category    String   // nombre del documento predefinido
  filePath    String?  // ruta al PDF subido
  signatures  Json     // array de objetos { name: string, present: boolean }
  applies   Boolean @default(true)
  optional  Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
